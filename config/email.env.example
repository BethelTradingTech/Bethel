# Copy these values into the environment used to start the API.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, app password required.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=replace_me
SMTP_PASSWORD=replace_me
SMTP_FROM_EMAIL=notifications@betheltradingtechnologies.com
SMTP_USE_STARTTLS=true
SMTP_USE_SSL=false
SUBSCRIBER_PORTAL_URL=https://betheltradingtechnologies.com/investor-frontend

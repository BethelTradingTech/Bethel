BETHEL_ENVIRONMENT=PRODUCTION
JWT_SECRET_KEY=generated_locally_do_not_commit
SUBSCRIBER_JWT_SECRET_KEY=generated_locally_do_not_commit
ADMIN_TOKEN_EXPIRE_HOURS=8
SUBSCRIBER_TOKEN_EXPIRE_MINUTES=60
AUTH_RATE_LIMIT_REQUESTS=12
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
FUND_PLATFORM_ENABLED=false
FUND_SIMULATED_EXECUTION=true
FUND_LIVE_DEPOSITS=false
FUND_LIVE_TRADING=false
FUND_LIVE_WITHDRAWALS=false

# Bethel native KYC. Keep Sumsub selected until /ready says ready_for_native_cutover=true.
IDENTITY_VERIFICATION_MODE=sumsub
KYC_ENCRYPTION_KEY=
KYC_STORAGE_ROOT=/var/data/bethel-kyc
# Set true only after /var/data is backed by persistent private storage (for example a Render persistent disk).
KYC_STORAGE_PERSISTENT=false
KYC_MAX_UPLOAD_BYTES=12582912
KYC_RETENTION_DAYS=2555
KYC_MALWARE_SCANNER_BASE_URL=
KYC_MALWARE_SCANNER_API_KEY=
KYC_OCR_BASE_URL=
KYC_OCR_API_KEY=
KYC_AUTHENTICITY_VERIFIER_BASE_URL=
KYC_AUTHENTICITY_VERIFIER_API_KEY=
KYC_BIOMETRIC_VERIFIER_BASE_URL=
KYC_BIOMETRIC_VERIFIER_API_KEY=
AML_SCREENING_MODE=local_dataset
AML_DATASET_MAX_AGE_DAYS=2
UK_SANCTIONS_CSV_URL=https://sanctionslist.fcdo.gov.uk/docs/UK-Sanctions-List.csv

# Legacy Sumsub variables are ignored when IDENTITY_VERIFICATION_MODE=native.
SUMSUB_BASE_URL=https://api.sumsub.com
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL_NAME=
SUMSUB_WEBHOOK_SECRET=
